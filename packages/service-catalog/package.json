{
  "name": "@cwygoda/service-catalog",
  "version": "0.19.0",
  "type": "module",
  "bin": {
    "service-catalog": "./bin/service-catalog.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./domain": {
      "types": "./dist/core/domain/index.d.ts",
      "import": "./dist/core/domain/index.js"
    },
    "./ports": {
      "types": "./dist/core/ports/index.d.ts",
      "import": "./dist/core/ports/index.js"
    },
    "./adapters": {
      "types": "./dist/core/adapters/index.d.ts",
      "import": "./dist/core/adapters/index.js"
    },
    "./schemas": {
      "types": "./dist/core/schemas/index.d.ts",
      "import": "./dist/core/schemas/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "style": "./dist/ui/source.css",
      "svelte": "./dist/ui/index.js"
    },
    "./ui/components": {
      "types": "./dist/ui/components/index.d.ts",
      "style": "./dist/ui/source.css",
      "svelte": "./dist/ui/components/index.js"
    },
    "./ui/stores": {
      "types": "./dist/ui/stores/index.d.ts",
      "style": "./dist/ui/source.css",
      "svelte": "./dist/ui/stores/index.js"
    },
    "./ui/graph": {
      "types": "./dist/ui/components/graph/index.d.ts",
      "import": "./dist/ui/components/graph/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.node.json && svelte-kit sync && svelte-package -o dist/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && svelte-kit sync && svelte-check"
  },
  "dependencies": {
    "@cwygoda/bpmn-txt": "^0.14.0",
    "@sinclair/typebox": "^0.34.48",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "elkjs": "^0.9.3",
    "graphology": "^0.26.0",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.6.0",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "bpmn-js": "^18.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.12.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^28.1.0",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
