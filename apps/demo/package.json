{
  "name": "@cwygoda/service-catalog-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:catalog && vite dev",
    "build": "pnpm build:catalog && vite build",
    "build:catalog": "service-catalog build -i demo-catalog -o static",
