    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@cwygoda/service-catalog-cli": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  }
