{
  "name": "@cwygoda/service-catalog-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:catalog && vite dev",
    "build": "pnpm build:catalog && vite build && pagefind --site build",
    "build:catalog": "service-catalog build -i ${CATALOG_DIR:-demo-catalog} -o static",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cwygoda/service-catalog-core": "workspace:*",
    "@cwygoda/service-catalog-ui": "workspace:*",
    "bpmn-js": "^18.12.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@cwygoda/service-catalog-cli": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.8",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
